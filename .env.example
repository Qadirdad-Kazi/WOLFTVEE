# =============================================================================
# WOLFTVEE — environment template
# =============================================================================
# Setup:
#   1. cp .env.example .env
#   2. Fill secrets below (never commit .env)
#   3. flutter pub get && flutter run
#
# Use YOUR keys only. Never copy Client IDs / API keys scraped from another APK.
# =============================================================================

# -----------------------------------------------------------------------------
# LIVE IPTV — global playable channel directory
# -----------------------------------------------------------------------------
# Primary live catalog (no key required). Open JSON from iptv-org:
#   channels.json / streams.json / logos.json / countries.json
# Powers Live TV with thousands of playable feeds (Sports prioritized).
IPTV_ORG_API_BASE=https://iptv-org.github.io/api

# Your Public IPTV host (publiciptv.com). Categories/countries are public.
# Full /api/channels needs a session/token until you open that route.
PUBLIC_IPTV_BASE_URL=https://publiciptv.com
PUBLIC_IPTV_TOKEN=

# -----------------------------------------------------------------------------
# PRIMARY — licensed playable catalog + live TV (Elo MAPI)
# -----------------------------------------------------------------------------
# Where: your licensed provider / product API (no public signup page).
# Default hosts below are the ones already wired for WOLFTVEE.
# Required for: movies/series with player[] URLs, Live TV (/new-broadcasts),
#               home rails (/catalog), posters on Elo CDN.
#
# Endpoints used (relative to MAPI_BASE_URL):
#   GET new-broadcasts
#   GET catalog
#   GET catalog/hollywood | catalog/bollywood | catalog/serials
MAPI_BASE_URL=https://mapi.elochkaigolochla.com/api/v1

# Where: same licensed provider’s image CDN (absolute poster URLs often come
# from the API already; this is the fallback base for relative paths).
IMG_CDN=https://img.elochkaigolochla.com

# Where: pick any 6-digit hex brand accent (no #). Used in UI theming.
# Example: C8FF00 (lime)
ACCENT_HEX=C8FF00

# -----------------------------------------------------------------------------
# SECONDARY — discovery / trending / posters / search gap-fill (TMDB)
# -----------------------------------------------------------------------------
# Where to get TMDB_API_KEY (free):
#   1. Create account: https://www.themoviedb.org/signup
#   2. Settings → API: https://www.themoviedb.org/settings/api
#   3. Request an API Key (choose “Developer”)
#   4. Copy the v3 auth key into TMDB_API_KEY below
#
# Required for: Trending now rail, More to explore gap-fill, TMDB posters,
#               search enrichment, series seasons/episodes metadata, trailers.
# App still runs without it (Elo-only catalog + playback).
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Where: official TMDB API host (leave default unless TMDB documents a change).
# Docs: https://developer.themoviedb.org/docs
TMDB_BASE_URL=https://api.themoviedb.org/3

# Where: official TMDB image CDN (leave default).
# Docs: https://developer.themoviedb.org/docs/image-basics
# Poster example: https://image.tmdb.org/t/p/w342/{poster_path}
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# -----------------------------------------------------------------------------
# OPTIONAL — Trakt trending lists (feeds TMDB IDs; TMDB still hydrates art)
# -----------------------------------------------------------------------------
# Where to get TRAKT_CLIENT_ID (free):
#   1. Create account: https://trakt.tv
#   2. API apps: https://trakt.tv/oauth/applications
#   3. “New Application”
#        - Name: WOLFTVEE (or any name)
#        - Redirect URI: urn:ietf:wg:oauth:2.0:oob
#        - Permissions: check what you need (public trending is enough)
#   4. Copy Client ID (NOT Client Secret for public trending GETs) here
#
# Docs: https://trakt.tv/oauth/applications
# API:  https://trakt.docs.apiary.io/
#
# What it does: authenticates GET /movies/trending and /shows/trending.
# If empty: app falls back to TMDB weekly trending alone (no Trakt needed).
#
# Optional second Client ID — tried automatically if primary returns ≠ 200
# (revoked key, rate limit, etc.). Leave blank if you only have one app.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_ID_FALLBACK=
TRAKT_BASE_URL=https://api.trakt.tv

# =============================================================================
# Quick checklist
# =============================================================================
# [ ] IPTV_ORG_API_BASE          → live channel directory (default OK)
# [ ] PUBLIC_IPTV_TOKEN (optional) → unlock your /api/channels list
# [ ] MAPI_BASE_URL + IMG_CDN     → licensed provider (playback + live)
# [ ] ACCENT_HEX                 → any brand hex
# [ ] TMDB_API_KEY               → themoviedb.org/settings/api
# [ ] TRAKT_CLIENT_ID (optional) → trakt.tv/oauth/applications
# [ ] TRAKT_CLIENT_ID_FALLBACK (optional) → second Client ID auto-tried on failure
# =============================================================================
